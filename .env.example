APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Seed mode for database seeding:
# - integer value => deterministic seed data
# - random        => non-deterministic seed data
DB_SEED=20260330

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Query monitoring log bindings (default redacted for safety)
LOG_QUERY_BINDINGS=false

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
# PostgreSQL SSL mode: disable, allow, prefer, require, verify-ca, verify-full
# Use require/verify-* for production environments with TLS.
DB_SSLMODE=prefer
# DB_DATABASE=rd_blog_dev
# DB_USERNAME=rd_blog_user
# DB_PASSWORD=
# Tests use DB_DATABASE=rd_blog_test — set DB_PASSWORD in your shell or here

# PostgreSQL Full-Text Search Language (for text search configuration)
# Common values: english, spanish, french, german, portuguese, italian, dutch, etc.
# See: https://www.postgresql.org/docs/current/textsearch-controls.html
DB_FTS_LANGUAGE=english

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Dashboard metrics cache hardening (Section 6)
DASHBOARD_CACHE_ENABLED=true
DASHBOARD_CACHE_TTL_SECONDS=600
DASHBOARD_CACHE_WARM_ENABLED=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
