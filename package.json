        "@types/markdown-it": "^14.1.2",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vitest/coverage-v8": "^4.1.8",
        "@vitest/ui": "^4.0.18",
        "@vue/eslint-config-typescript": "^14.8.0",
        "@vue/test-utils": "^2.4.11",
        "concurrently": "^9.0.1",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.0.1",
